# Copy to frontend/.env.local. Never commit .env files.
# NEXT_PUBLIC_ variables are bundled into browser code: never put secrets in them.

NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk: run `clerk init --accountless` for temporary dev keys, or copy them from
# https://dashboard.clerk.com (API keys). The secret key must never be NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
