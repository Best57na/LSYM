# Copy to backend/.env and fill in real values. Never commit .env.

APP_ENV=development

# Local MongoDB works out of the box. For Atlas, use the connection string from
# Atlas > Database > Connect > Drivers, e.g.:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=slipwise

# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# Added in later phases:
# CLERK_JWKS_URL=
# CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
# ANTHROPIC_API_KEY=
